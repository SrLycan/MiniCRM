# Copia este archivo como .env. Los valores son solo para desarrollo y demo.

DJANGO_DEBUG=true
# Genera uno propio con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=solo-para-demo-local-reemplazar-en-cualquier-otro-entorno
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Firma del webhook de WhatsApp simulado. Sin este valor, y sin DJANGO_DEBUG, el webhook
# y el botón de simulación quedan desactivados.
WHATSAPP_APP_SECRET=solo-para-demo-local-reemplazar-en-cualquier-otro-entorno

# Usuario creado por `python manage.py seed_demo`
DEMO_USERNAME=demo
DEMO_PASSWORD=Orbita-Demo-2026
# Muestra estas credenciales en la pantalla de login
DEMO_LOGIN_HINT=true
